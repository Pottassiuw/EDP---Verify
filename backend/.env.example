# ── Perfil de execução ────────────────────────────────────────────────────
# local (padrão)  → banco em backend/data/ (desenvolvimento e testes)
# producao        → banco compartilhado da rede; falha explícita se offline
EDP_PERFIL=local
# Raiz do compartilhamento da rede (todos os caminhos de base derivam dela).
# Peça o valor ao administrador da rede; não versione um caminho real aqui.
# INPUT_REDE_RAIZ=\\SERVIDOR\Compartilhamento\...
# Override do banco de notas (vence o perfil; usado também pelo robô SAP).
# INPUT_DB_PATH=\\SERVIDOR\Compartilhamento\...\notas_departamento.db
# Libera o UPDATE em massa Status_Obra → Observacao no perfil de produção.
# INPUT_MIGRAR_STATUS_OBRA=1

# ── Diagnóstico ───────────────────────────────────────────────────────────
# EDP_PERF=1 liga os logs [COFFEE-PERF] (duração e tamanho de /api/data e
# /api/coffee/*). No navegador: localStorage.setItem('edp_perf','1').
# EDP_PERF=1

# Credenciais Databricks — copie para backend/.env e preencha (não versionar o .env)
# Databricks > User Settings > Developer > Access tokens
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Catálogo/schema onde vive a base COFFEE (Carteira usa coffee_onr_es_sp)
DATABRICKS_CATALOG=sandbox_uc
DATABRICKS_SCHEMA=ddpm
